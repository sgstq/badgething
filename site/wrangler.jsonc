{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "badgething-app",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "badgething.app", "custom_domain": true },
    { "pattern": "www.badgething.app", "custom_domain": true }
  ]
}
